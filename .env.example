# Copy to .env and adjust. Every value here has a working default,
# so the app runs with no .env at all.

# HTTP listener
PORT=3000
HOST=127.0.0.1

# SQLite database file. Created and seeded on first boot.
DATABASE_FILE=data/horizon.db

# Set to false to boot an empty database with no demo accounts or projects.
SEED_DEMO_DATA=true

# Set to true when serving over HTTPS so the session cookie gets the Secure flag.
SECURE_COOKIES=false

# Set to true only behind a reverse proxy you control, so X-Forwarded-Proto
# and X-Forwarded-For are trusted for protocol detection and rate limiting.
TRUST_PROXY=false
